# Copy to .env and fill in your key from https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_cloud_key_here
# Free plan default picker: gemma4:31b (auto-recommended) | full list via /api/models
OLLAMA_MODEL=gemma4:31b
PORT=8787
# After upgrading your Ollama plan, set this to 1 to show ALL cloud models:
ALLOW_ALL_MODELS=0

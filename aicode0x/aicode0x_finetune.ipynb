  {"cell_type": "code", "metadata": {}, "source": ["SYS = 'You are aicode:0x, an expert full-stack web developer that builds complete, working single-page apps from a user description. You output HTML + CSS + JavaScript using FILE blocks. You use the creat SDK (creat.db, creat.push, creat.live, creat.server, creat.call, creat.me, creat.lib.load) for persistence, multiplayer, and serverless functions. You always write polished, modern, mobile-friendly apps. You always null-check creat.me(). You never use localStorage for app data.'\n", "\n", "examples = [\n", "  {'u':'Build a todo app with priorities and due dates','d':'Dark todo app with priorities, due dates, overdue detection, creat.db storage.','c':'<div class=\\\"container\\\"><h1>Todo</h1><div class=\\\"input-row\\\"><input id=\\\"inp\\\" placeholder=\\\"Task...\\\"/><select id=\\\"pri\\\"><option value=\\\"low\\\">Low</option><option value=\\\"med\\\">Med</option><option value=\\\"high\\\">High</option></select><input type=\\\"date\\\" id=\\\"due\\\"/><button onclick=\\\"add()\\\">Add</button></div><div id=\\\"list\\\"></div></div><script>(function(){var C=\\\"todos\\\",todos=[];window.add=async function(){var t=document.getElementById(\\\"inp\\\").value.trim();if(!t)return;var item={text:t,priority:document.getElementById(\\\"pri\\\").value,due:document.getElementById(\\\"due\\\").value||null,done:false};var c=await creat.db.insert(C,item);todos.push(c);render();document.getElementById(\\\"inp\\\")\\\u003b.value=\\\"\\\"};window.toggle=async function(id){var x=todos.find(function(y){return y.id===id});if(!x)return;x.done=!x.done;await creat.db.update(C,id,{done:x.done});render()};window.del=async function(id){await creat.db.remove(C,id);todos=todos.filter(function(y){return y.id!==id});render()};function render(){var el=document.getElementById(\\\"list\\\");el.innerHTML=todos.map(function(t){var today=new Date().toISOString().slice(0,10);var od=t.due&&!t.done&&t.due<today;return \\\"<div class=\\\\\\\"todo-item\\\"+\\\"(t.done?\\\\\\\" done\\\\\\\":\\\\\\\"\\\\\\\")+\\\\\\\"\\\\\\\">\\\"+\\\"<input type=\\\\\\\"checkbox\\\\\\\" \\\"+(t.done?\\\\\\\"checked\\\\\\\":\\\\\\\"\\\\\\\")+\\\\\\\" onclick=\\\\\\\\\\\\\\\\\\\"toggle(\\\\\\\\\\\\\\\\\\\\\\\"+t.id+\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\\\\\\\\\\\\">\\\"+\\\"<span>\\\"+t.text+\\\\\\\"</span>\\\"+\\\"<span class=\\\\\\\\\\\\\\\"pri-\\\"+t.priority+\\\\\\\\\\\\\\\">\\\"+t.priority.toUpperCase()+\\\\\\\"</span>\\\"+\\\"</div>\\\"}).join(\\\\\\\"\\\\\\\")}async function init(){todos=await creat.db.list(C);render()}init()})();</script>'},\n", "  {'u':'Make a multiplayer chat room with colored usernames','d':'Real-time chat via creat.server, consistent user colors, instant delivery.','c':'<div id=\\\"app\\\"><div class=\\\"header\\\">Chat<span id=\\\"status\\\">Connecting...</span></div><div id=\\\"msgs\\\"></div><div class=\\\"bar\\\"><input id=\\\"inp\\\" placeholder=\\\"Type...\\\"/><button onclick=\\\"send()\\\">Send</button></div></div><script>(function(){var R=\\\"chat\\\",C=[\\\"#ff6b6b\\\",\\\"#ffd93d\\\",\\\"#6bcb77\\\",\\\"#4d96ff\\\",\\\"#ff6eb4\\\",\\\"#a855f7\\\"],uc={},my=null;function gc(n){if(!uc[n]){var h=0;for(var i=0;i<n.length;i++)h=n.charCodeAt(i)+((h5)-h);uc[n]=C[Math.abs(h)%C.length]}return uc[n]}function esc(s){var d=document.createElement(\\\"div\\\");d.textContent=s;return d.innerHTML}window.send=async function(){var t=document.getElementById(\\\"inp\\\").value.trim();if(!t)return;document.getElementById(\\\"inp\\\").value=\\\"\\\";await creat.server(R).push({type:\\\"msg\\\",text:t})};async function init(){var me=await creat.me().catch(function(){return null});my=(me&&me.username)||null;document.getElementById(\\\"status\\\").textContent=my||\\\"Anon\\\";creat.server(R).subscribe(function(e){if(e.type===\\\"msg\\\"){var el=document.getElementById(\\\"msgs\\\");var d=document.createElement(\\\"div\\\");d.innerHTML=\\\"<b style=\\\\\\\"color:\\\"+gc(e.user)+\\\"\\\\\\\">\\\"+esc(e.user)+\\\"</b>: \\\"+esc(e.data.text);el.appendChild(d);el.scrollTop=el.scrollHeight}})}init()})();</script>'},\n", "  {'u':'Build a canvas drawing app with color picker and undo','d':'Drawing app with color picker, brush size, eraser, undo/redo, save PNG.','c':'<div class=\\\"toolbar\\\"><input type=\\\"color\\\" id=\\\"color\\\" value=\\\"#fff\\\"/><input type=\\\"range\\\" id=\\\"size\\\" min=\\\"1\\\" max=\\\"50\\\" value=\\\"3\\\"/><button onclick=\\\"undo()\\\">Undo</button><button onclick=\\\"clear()\\\">Clear</button><button onclick=\\\"save()\\\">Save</button></div><canvas id=\\\"c\\\"></canvas><script>(function(){var cv=document.getElementById(\\\"c\\\"),ctx=cv.getContext(\\\"2d\\\"),drawing=false,hist=[];function resize(){cv.width=cv.offsetWidth;cv.height=cv.offsetHeight}resize();window.addEventListener(\\\"resize\\\",resize);saveState();function saveState(){hist.push(cv.toDataURL());if(hist.length>50)hist.shift()}window.undo=function(){if(hist.length<=1)return;hist.pop();var img=new Image();img.onload=function(){ctx.clearRect(0,0,cv.width,cv.height);ctx.drawImage(img,0,0)};img.src=hist[hist.length-1]};window.clear=function(){ctx.fillStyle=\\\"#fff\\\";ctx.fillRect(0,0,cv.width,cv.height);saveState()};window.save=function(){var a=document.createElement(\\\"a\\\");a.download=\\\"drawing.png\\\";a.href=cv.toDataURL();a.click()};function gp(e){var r=cv.getBoundingClientRect(),t=e.touches?e.touches[0]:e;return{x:t.clientX-r.left,y:t.clientY-r.top}}cv.onmousedown=function(e){drawing=true;var p=gp(e);ctx.beginPath();ctx.moveTo(p.x,p.y)};cv.onmousemove=function(e){if(!drawing)return;var p=gp(e);ctx.lineWidth=document.getElementById(\\\"size\\\").value;ctx.lineCap=\\\"round\\\";ctx.strokeStyle=document.getElementById(\\\"color\\\").value;ctx.lineTo(p.x,p.y);ctx.stroke()};cv.onmouseup=cv.onmouseleave=function(){if(drawing){drawing=false;saveState()}};document.onkeydown=function(e){if((e.ctrlKey||e.metaKey)&&e.key===\\\"z\\\"){e.preventDefault();undo()}}})()</script>'},\n", "  {'u':'Create a landing page for a coffee shop with an order form','d':'Landing page with nav, hero, menu grid, order form saving to creat.db.','c':'<nav><a href=\\\"#menu\\\">Menu</a><a href=\\\"#order\\\">Order</a></nav><div class=\\\"hero\\\"><h1>Brew & Bean</h1><p>Specialty coffee roasted daily</p><a href=\\\"#order\\\" class=\\\"cta\\\">Order Now</a></div><section id=\\\"menu\\\"><div class=\\\"grid\\\"><div class=\\\"item\\\"><h3>Espresso</h3><p>$3.50</p></div><div class=\\\"item\\\"><h3>Oat Latte</h3><p>$5.00</p></div><div class=\\\"item\\\"><h3>Cold Brew</h3><p>$4.50</p></div><div class=\\\"item\\\"><h3>Croissant</h3><p>$3.00</p></div></div></section><section id=\\\"order\\\"><form id=\\\"f\\\"><input id=\\\"name\\\" placeholder=\\\"Name\\\" required/><select id=\\\"item\\\" required><option>Espresso - $3.50</option><option>Oat Latte - $5.00</option><option>Cold Brew - $4.50</option><option>Croissant - $3.00</option></select><button type=\\\"submit\\\">Order</button></form></section><script>document.getElementById(\\\"f\\\").onsubmit=async function(e){e.preventDefault();await creat.db.insert(\\\"orders\\\",{name:document.getElementById(\\\"name\\\").value,item:document.getElementById(\\\"item\\\").value,ts:Date.now()});alert(\\\"Ordered!\\\")}</script>'},\n", "  {'u':'Build a weather dashboard with current conditions and 5-day forecast','d':'Weather dashboard using free Open-Meteo API, no key needed.','c':'<div class=\\\"container\\\"><h1>Weather</h1><div class=\\\"search\\\"><input id=\\\"city\\\" placeholder=\\\"City...\\\"/><button onclick=\\\"search()\\\">Go</button></div><div id=\\\"out\\\"></div></div><script>var IC={0:\\\"Sun\\\",1:\\\"Clear\\\",2:\\\"Partly cloudy\\\",3:\\\"Cloudy\\\",45:\\\"Fog\\\",51:\\\"Drizzle\\\",61:\\\"Rain\\\",71:\\\"Snow\\\",80:\\\"Showers\\\",95:\\\"Thunderstorm\\\"};window.search=async function(){var c=document.getElementById(\\\"city\\\").value.trim();if(!c)return;var o=document.getElementById(\\\"out\\\");o.innerHTML=\\\"Loading...\\\";try{var g=await(await fetch(\\\"https://geocoding-api.open-meteo.com/v1/search?name=\\\"+encodeURIComponent(c)+\\\"&count=1\\\")).json();if(!g.results||!g.results.length)throw new Error(\\\"Not found\\\");var la=g.results[0].latitude,lo=g.results[0].longitude,nm=g.results[0].name;var w=await(await fetch(\\\"https://api.open-meteo.com/v1/forecast?latitude=\\\"+la+\\\"&longitude=\\\"+lo+\\\"&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=5\\\")).json();var cw=w.current;var h=\\\"<div class=current><h2>\\\"+nm+\\\"</h2><div class=temp>\\\"+Math.round(cw.temperature_2m)+\\\"C</div><div>\\\"+(IC[cw.weather_code]||\\\"\\\")+\\\"</div><div>Humidity: \\\"+cw.relative_humidity_2m+\\\"% Wind: \\\"+Math.round(cw.wind_speed_10m)+\\\"km/h</div></div><div class=forecast>\\\";for(var i=0;i<5;i++){h+=\\\"<div class=day><b>\\\"+w.daily.time[i]+\\\"</b><br>\\\"+Math.round(w.daily.temperature_2m_max[i])+\\\"/\\\"+Math.round(w.daily.temperature_2m_min[i])+\\\"C</div>\\\"}h+=\\\"</div>\\\";o.innerHTML=h}catch(e){o.innerHTML=e.message}}document.getElementById(\\\"city\\\").onkeydown=function(e){if(e.key===\\\"Enter\\\")search()}</script>'},\n", "  {'u':'Build a multiplayer tic-tac-toe game with a lobby','d':'Multiplayer tic-tac-toe with lobby, real-time sync via Supabase Realtime.','c':'<div id=\\\"lobby\\\"><h1>Tic Tac Toe</h1><button onclick=\\\"create()\\\">New Game</button><div id=\\\"games\\\"></div></div><div id=\\\"game\\\" style=\\\"display:none\\\"><div id=\\\"status\\\"></div><div id=\\\"board\\\"></div><button onclick=\\\"leave()\\\">Leave</button></div><script>(function(){var LOB=\\\"ttt\\\",gs={},mg=null,mm=null,srv=null,me=null;var W=[[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];function rl(){var o=Object.values(gs).filter(function(g){return g.s===\\\"wait\\\"});document.getElementById(\\\"games\\\").innerHTML=o.length?o.map(function(g){return \\\"<div>\\\"+g.h+\\\"'s game <button onclick=join(\\\\\\\"\\\"+g.id+\\\"\\\\\\\")>Join</button></div>\\\"}).join(\\\"\\\"):\\\"No games\\\"}window.join=function(id){mg=gs[id];mm=\\\"O\\\";document.getElementById(\\\"lobby\\\").style.display=\\\"none\\\";document.getElementById(\\\"game\\\").style.display=\\\"\\\";sg(id)};window.create=async function(){var id=\\\"g-\\\"+Date.now();mg={id:id,h:me,b:Array(9).fill(null),t:\\\"X\\\",s:\\\"wait\\\",w:null};mm=\\\"X\\\";gs[id]=mg;await creat.server(LOB).push({type:\\\"new\\\",id:id,h:me});document.getElementById(\\\"lobby\\\").style.display=\\\"none\\\";document.getElementById(\\\"game\\\").style.display=\\\"\\\";sg(id)};function rb(){document.getElementById(\\\"board\\\").innerHTML=mg.b.map(function(v,i){return \\\"<div class=cell onclick=play(\\\"+i+\\\")>\\\"+(v||\\\"\\\")+\\\"</div>\\\"}).join(\\\"\\\")}function us(){var el=document.getElementById(\\\"status\\\");if(mg.w)el.innerHTML=mg.w===mm?\\\"You win!\\\":mg.w+\\\" wins!\\\";else el.innerHTML=mg.t===mm?\\\"Your turn (\\\"+mm+\\\")\\\":\\\"Opponent turn\\\"}window.play=function(i){if(!mg||mg.b[i]||mg.t!==mm||mg.w)return;mg.b[i]=mm;mg.t=mg.t===\\\"X\\\"?\\\"O\\\":\\\"X\\\";var w=cw(mg.b);if(w)mg.w=w;else if(mg.b.every(function(v){return v}))mg.w=\\\"draw\\\";srv.push({type:\\\"move\\\",i:i,m:mm,t:mg.t,w:mg.w});rb();us()};function cw(b){for(var i=0;i<W.length;i++){var a=W[i];if(b[a[0]]&&b[a[0]]===b[a[1]]&&b[a[1]]===b[a[2]])return b[a[0]]}return null}function sg(id){srv=creat.server(id);srv.subscribe(function(e){if(e.type===\\\"move\\\"){mg.b[e.i]=e.m;mg.t=e.t;mg.w=e.w;rb();us()}});rb();us()}window.leave=function(){if(srv)srv.close();document.getElementById(\\\"lobby\\\").style.display=\\\"\\\";document.getElementById(\\\"game\\\").style.display=\\\"none\\\";mg=null;rl()};async function init(){var u=await creat.me().catch(function(){return null});me=(u&&u.username)||\\\"anon\\\";creat.server(LOB).subscribe(function(e){if(e.type===\\\"new\\\")gs[e.data.id]={id:e.data.id,h:e.data.h,b:Array(9).fill(null),t:\\\"X\\\",s:\\\"wait\\\",w:null};rl()});rl()}init()})();</script>'},\n", "  {'u':'Build a note-taking app with markdown support and search','d':'Markdown notes with sidebar, live preview, search, auto-save via creat.db.','c':'<div class=\\\"sidebar\\\"><input id=\\\"search\\\" placeholder=\\\"Search...\\\"/><div id=\\\"list\\\"></div><button onclick=\\\"newNote()\\\">+ New</button></div><div class=\\\"editor\\\"><textarea id=\\\"area\\\" placeholder=\\\"Write markdown...\\\"></textarea><div id=\\\"preview\\\"></div></div><script>(function(){var C=\\\"notes\\\",notes=[],aid=null;var area=document.getElementById(\\\"area\\\"),pv=document.getElementById(\\\"preview\\\");function md(s){return s.replace(/^### (.+)$/gm,\\\"<h3>$1</h3>\\\").replace(/^## (.+)$/gm,\\\"<h2>$1</h2>\\\").replace(/^# (.+)$/gm,\\\"<h1>$1</h1>\\\").replace(/\\*\\*(.+?)\\*\\*/g,\\\"<b>$1</b>\\\").replace(/\\*(.+?)\\*/g,\\\"<i>$1</i>\\\").replace(/^- (.+)$/gm,\\\"<li>$1</li>\\\").replace(/\\n\\n/g,\\\"<br><br>\\\")}function rl(){document.getElementById(\\\"list\\\").innerHTML=notes.map(function(n){return \\\"<div class=\\\"+(n.id===aid?\\\"active\\\":\\\"\\\")+\\\" onclick=openNote(\\\\\\\"\\\"+n.id+\\\"\\\\\\\")>\\\"+(n.title||\\\"Untitled\\\")+\\\"</div>\\\"}).join(\\\"\\\")}window.openNote=function(id){aid=id;var n=notes.find(function(x){return x.id===id});if(!n)return;area.value=n.body||\\\"\\\"};window.newNote=async function(){var n=await creat.db.insert(C,{title:\\\"New Note\\\",body:\\\"\\\"});notes.push(n);openNote(n.id)};var st=null;area.oninput=function(){clearTimeout(st);st=setTimeout(async function(){var n=notes.find(function(x){return x.id===aid});if(!n)return;n.body=area.value;n.title=area.value.split(\\\"\\\\n\\\")[0].replace(/^#+\\s*/,\\\"\\\").slice(0,60)||\\\"Untitled\\\";pv.innerHTML=md(area.value);await creat.db.update(C,n.id,{body:n.body,title:n.title});rl()},400)};async function init(){notes=await creat.db.list(C);rl()}init()})();</script>'},\n", "  {'u':'Build a kanban board with drag and drop columns','d':'Kanban with 3 columns, HTML5 drag-drop, priorities, creat.db persistence.','c':'<div class=\\\"board\\\" id=\\\"board\\\"></div><script>(function(){var C=\\\"kanban\\\",cards=[];var COLS=[{id:\\\"todo\\\",t:\\\"To Do\\\"},{id:\\\"wip\\\",t:\\\"In Progress\\\"},{id:\\\"done\\\",t:\\\"Done\\\"}];function rb(){document.getElementById(\\\"board\\\").innerHTML=COLS.map(function(col){var cc=cards.filter(function(c){return c.col===col.id});return \\\"<div class=column ondragover=event.preventDefault() ondrop=drop(event,\\\\\\\"\\\"+col.id+\\\"\\\\\\\")><h3>\\\"+col.t+\\\" (\\\"+cc.length+\\\")</h3>\\\"+cc.map(function(c){return \\\"<div class=card draggable ondragstart=ds(event,\\\\\\\"\\\"+c.id+\\\"\\\\\\\")>\\\"+c.text+\\\" <button onclick=del(\\\\\\\"\\\"+c.id+\\\"\\\\\\\")>x</button></div>\\\"}).join(\\\"\\\")+\\\"<input placeholder=\\\"New...\\\" onkeydown=if(event.key===Enter)add(this,\\\\\\\"\\\"+col.id+\\\"\\\\\\\")></div>\\\"}).join(\\\"\\\")}var did=null;window.ds=function(e,id){did=id};window.drop=async function(e,col){e.preventDefault();if(!did)return;var c=cards.find(function(x){return x.id===did});if(!c)return;c.col=col;await creat.db.update(C,c.id,{col:col});did=null;rb()};window.add=async function(inp,col){var t=inp.value.trim();if(!t)return;var c=await creat.db.insert(C,{text:t,col:col,pri:\\\"med\\\"});cards.push(c);inp.value=\\\"\\\";rb()};window.del=async function(id){await creat.db.remove(C,id);cards=cards.filter(function(x){return x.id!==id});rb()};async function init(){cards=await creat.db.list(C);rb()}init()})();</script>'},\n", "  {'u':'Build a 2D physics sandbox where I can spawn objects and they collide','d':'2D physics sandbox using planck.js, spawn boxes/circles, drag to throw.','c':'<canvas id=\\\"c\\\"></canvas><div class=\\\"bar\\\"><button onclick=\\\"tool=\\\\\\\"box\\\\\\\"\\\">Box</button><button onclick=\\\"tool=\\\\\\\"circ\\\\\\\"\\\">Circle</button><button onc
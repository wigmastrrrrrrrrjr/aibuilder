{
 "cells": [
  {"cell_type": "markdown", "metadata": {}, "source": ["# aicode:0x — Fine-tuning Qwen2.5-Coder-1.5B for aibuilder\n", "\n", "This notebook fine-tunes **Qwen2.5-Coder-1.5B-Instruct** using QLoRA on Lightning AI.\n", "Output: a GGUF file you can import into Ollama as `aicode:0x`."]},
  {"cell_type": "code", "metadata": {}, "source": ["!pip install -q transformers peft trl datasets bitsandbytes accelerate"), "execution_count": null, "outputs": []},
  {"cell_type": "code", "metadata": {}, "source": ["import torch, json, os\n", "from datasets import Dataset\n", "from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n", "from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\n", "from trl import SFTTrainer, SFTConfig\n", "\n", "MODEL_ID = 'Qwen/Qwen2.5-Coder-1.5B-Instruct'\n", "OUTPUT_DIR = './aicode0x-output'\n", "os.makedirs(OUTPUT_DIR, exist_ok=True)"), "execution_count": null, "outputs": []},
  {"cell_type": "markdown", "metadata": {}, "source": ["## Load training data\n", "Upload `train_data.jsonl` to the notebook, or mount from Google Drive."]},
  {"cell_type": "code", "metadata": {}, "source": ["# Option 1: Upload train_data.jsonl manually\n", "# from google.colab import files\n", "# uploaded = files.upload()\n", "\n", "# Option 2: Load from path\n", "TRAIN_FILE = 'train_data.jsonl'\n", "data = []\n", "with open(TRAIN_FILE) as f:\n", "    for line in f:\n", "        data.append(json.loads(line.strip()))\n", "print(f'Loaded {len(data)} examples')\n", "dataset = Dataset.from_list(data)"), "execution_count": null, "outputs": []},
  {"cell_type": "markdown", "metadata": {}, "source": ["## Load model with 4-bit quantization"]]},
  {"cell_type": "code", "metadata": {}, "source": ["bnb_config = BitsAndBytesConfig(\n", "    load_in_4bit=True,\n", "    bnb_4bit_quant_type='nf4',\n", "    bnb_4bit_compute_dtype=torch.bfloat16,\n", "    bnb_4bit_use_double_quant=True,\n", ")\n", "\n", "model = AutoModelForCausalLM.from_pretrained(\n", "    MODEL_ID,\n", "    quantization_config=bnb_config,\n", "    device_map='auto',\n", "    trust_remote_code=True,\n", ")\n", "tokenizer = AutoTokenizer.from_pretrained(MODEL_ID, trust_remote_code=True)\n", "if tokenizer.pad_token is None:\n", "    tokenizer.pad_token = tokenizer.eos_token\n", "model = prepare_model_for_kbit_training(model)"), "execution_count": null, "outputs": []},
  {"cell_type": "markdown", "metadata": {}, "source": ["## Configure LoRA adapter"]]},
  {"cell_type": "code", "metadata": {}, "source": ["lora_config = LoraConfig(\n", "    r=16,\n", "    lora_alpha=32,\n", "    target_modules=['q_proj','k_proj','v_proj','o_proj','gate_proj','up_proj','down_proj'],\n", "    lora_dropout=0.05,\n", "    bias='none',\n", "    task_type='CAUSAL_LM',\n", ")\n", "model = get_peft_model(model, lora_config)\n", "model.print_trainable_parameters()"), "execution_count": null, "outputs": []},
  {"cell_type": "markdown", "metadata": {}, "source": ["## Train"]]},
  {"cell_type": "code", "metadata": {}, "source": ["training_config = SFTConfig(\n", "    output_dir=OUTPUT_DIR,\n", "    num_train_epochs=3,\n", "    per_device_train_batch_size=2,\n", "    gradient_accumulation_steps=4,\n", "    learning_rate=2e-4,\n", "    lr_scheduler_type='cosine',\n", "    warmup_ratio=0.1,\n", "    logging_steps=10,\n", "    save_strategy='epoch',\n", "    bf16=True,\n", "    max_seq_length=4096,\n", "    dataset_text_field=None,\n", "    packing=False,\n", ")\n", "\n", "trainer = SFTTrainer(\n", "    model=model,\n", "    args=training_config,\n", "    train_dataset=dataset,\n", "    processing_class=tokenizer,\n", ")\n", "\n", "trainer.train()"), "execution_count": null, "outputs": []},
  {"cell_type": "markdown", "metadata": {}, "source": ["## Save LoRA adapter"]]},
  {"cell_type": "code", "metadata": {}, "source": ["model.save_pretrained(os.path.join(OUTPUT_DIR, 'lora-adapter'))\n", "tokenizer.save_pretrained(os.path.join(OUTPUT_DIR, 'lora-adapter'))\n", "print('Saved to', OUTPUT_DIR + '/lora-adapter')"), "execution_count": null, "outputs": []},
  {"cell_type": "markdown", "metadata": {}, "source": ["## Merge and export to GGUF\n", "This converts the fine-tuned model to GGUF format for Ollama."]},
  {"cell_type": "code", "metadata": {}, "source": ["# Install llama.cpp for GGUF export\n", "!pip install -q llama-cpp-python\n", "!git clone --depth 1 https://github.com/ggml-org/llama.cpp.git /tmp/llama.cpp || true\n", "!cd /tmp/llama.cpp && pip install -r requirements/requirements-convert_hf_to_gguf.txt 2>/dev/null || true"), "execution_count": null, "outputs": []},
  {"cell_type": "code", "metadata": {}, "source": ["# Merge LoRA into base model and export GGUF\n", "from peft import PeftModel\n", "\n", "base_model = AutoModelForCausalLM.from_pretrained(\n", "    MODEL_ID,\n", "    torch_dtype=torch.bfloat16,\n", "    device_map='cpu',\n", "    trust_remote_code=True,\n", ")\n", "merged = PeftModel.from_pretrained(base_model, os.path.join(OUTPUT_DIR, 'lora-adapter'))\n", "merged = merged.merge_and_unload()\n", "merged.save_pretrained(os.path.join(OUTPUT_DIR, 'merged'))\n", "tokenizer.save_pretrained(os.path.join(OUTPUT_DIR, 'merged'))\n", "print('Merged model saved')"), "execution_count": null, "outputs": []},
  {"cell_type": "code", "metadata": {}, "source": ["# Convert to GGUF\n", "!python /tmp/llama.cpp/convert_hf_to_gguf.py \\\n", "    {OUTPUT_DIR}/merged \\\n", "    --outfile {OUTPUT_DIR}/aicode0x-Q4_K_M.gguf \\\n", "    --outtype q4_k_m\n", "\n", "print('GGUF exported:', OUTPUT_DIR + '/aicode0x-Q4_K_M.gguf')\n", "print('Download this file and run: ollama create aicode0x -f Modelfile')"), "execution_count": null, "outputs": []}
 ],
